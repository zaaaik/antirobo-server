# Copiá este archivo a ".env" (que ya está en .gitignore) y completá los valores.
# En Render, estas mismas variables se configuran en Dashboard -> tu servicio -> Environment.

# Connection string de tu cluster de MongoDB Atlas (ver README para el paso a paso).
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/antirobo?retryWrites=true&w=majority

# Secreto usado para firmar las sesiones de login. Poné algo largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Credenciales del único usuario admin. Se crean automáticamente la primera vez
# que arranca el servidor y no hay ningún usuario todavía en la base.
ADMIN_USER=admin
ADMIN_PASSWORD=elegi-una-contrasena-segura
